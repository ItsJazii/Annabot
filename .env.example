# Anna - Telegram Translation + AI Chat Bot
# Fill in your real credentials below
# NEVER commit this file or .env to GitHub!

# Get this from @BotFather after creating your bot
BOT_TOKEN=your_telegram_bot_token_here

# Bot owner ID (your Telegram numeric user ID)
# Find it via @userinfobot or by sending /start to @getidsbot
BOT_OWNER_ID=your_telegram_user_id_here

# OpenRouter (paid, primary AI provider, also handles web search + vision)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional OpenRouter model override. Default in code: google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# Groq (free fallback chat + Whisper voice transcription)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras (free fallback chat)
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# CoinMarketCap (OPTIONAL — adds a fallback price source for /price queries)
# Free tier: 10k calls/month. https://pro.coinmarketcap.com/account
# Anna already uses DexScreener (no key) and CoinGecko (no key) by default,
# so CMC is only needed if those two miss the coin.
CMC_API_KEY=your_cmc_api_key_here

# Supabase (optional - falls back to local JSON if not set)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
