# Anna — Personal AI Assistant
# Fill in your credentials below. NEVER commit .env to git!

# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram numeric user ID (find via @userinfobot)
BOT_OWNER_ID=your_telegram_user_id_here

# OpenRouter (primary AI provider)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional model override (default: google/gemini-2.5-flash)
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Groq (fallback AI provider)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras (second fallback AI provider)
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Supabase (optional — falls back to local JSON if not set)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
