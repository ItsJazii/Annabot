# Anna - Telegram Translation + AI Chat Bot
# Fill in your real credentials below
# NEVER commit this file or .env to GitHub!

# Get this from @BotFather after creating your bot
BOT_TOKEN=your_telegram_bot_token_here

# Groq AI (free tier, 30 req/min) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras AI (free tier, fallback) — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenRouter (paid, fast, primary provider) — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Custom Search (optional, for web search) — https://developers.google.com/custom-search
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# Supabase (optional - falls back to local JSON if not set)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Bot owner ID (your Telegram numeric user ID)
# Find it via @userinfobot or by sending /start to @getidsbot
BOT_OWNER_ID=your_telegram_user_id_here
